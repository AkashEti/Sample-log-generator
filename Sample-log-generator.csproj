<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SampleLogGenerator</RootNamespace>
    <!-- Generator version, recorded in every dataset manifest together with the git commit. -->
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
  </ItemGroup>

  <!--
    The SDK (Source Link) already stamps the git commit into the informational version (1.3.0+<sha>), which
    GeneratorInfo reads back for dataset manifests. This adds "-dirty" when the build had uncommitted changes,
    so a dataset can never be mistaken for the output of a clean commit.
  -->
  <Target Name="MarkDirtyWorkingTree" AfterTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitChanges" />
    </Exec>
    <PropertyGroup Condition="'$(GitChanges)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
