{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LogGenerator": {
    "AutoStart": true,
    "OutputDirectory": "logs",
    "DatasetsDirectory": "datasets",
    "Environment": "Production",
    "MinConcurrentUsers": 30,
    "MaxConcurrentUsers": 100,
    "TickMilliseconds": 250,
    "MetricsIntervalSeconds": 10,
    "AutoIncidents": true,
    "MinSecondsBetweenIncidents": 120,
    "MaxSecondsBetweenIncidents": 300,
    "MinIncidentDurationSeconds": 60,
    "MaxIncidentDurationSeconds": 180,
    "EnabledScenarios": [],
    "DistractorsPerIncident": 0,
    "IncludePromptInjection": false,
    "Seed": null,
    "EchoToConsole": true
  }
}
